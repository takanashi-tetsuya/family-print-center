# Replace this with the OpenWrt LAN address before opening the page on a phone.
PRINT_CENTER_HOST=127.0.0.1
PRINT_CENTER_PORT=8080
MAX_UPLOAD_MB=100
CONVERSION_TIMEOUT=180
RETENTION_HOURS=24

# URL of the complete source for the version you run (repository/tag or source archive).
# When set, the home and administrator pages display a source-code link.
# Use an absolute HTTP(S) URL without a username or password.
SOURCE_CODE_URL=

# Optional. First-start administrator password for /admin. Leave empty to have one
# generated into the data volume (admin-initial-password); change it after logging in.
ADMIN_PASSWORD=
